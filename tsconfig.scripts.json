{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/lib/**/*", "scripts/**/*", "evals/**/*", "seed/**/*", "db/**/*"],
  "exclude": ["src/lib/pdf.tsx", "src/lib/supabase", "src/lib/server", "src/lib/useWorkspace.ts"]
}
